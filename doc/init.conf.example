# /etc/systema/init.conf — System Init (systema-sysi) module selection.
#
# Syntax follows systemd's system.conf: assignments live in a section;
# blank lines and lines starting with '#' or ';' are ignored.  [Init]
# selects the allocator and the finder; [Workers] selects the supervised
# modules.
#
# A key that is missing keeps the built-in default shown below (commented
# out).  An EMPTY value disables the module:
#
#     Device=
#
# A value is either a plain executable name or an absolute path.  Plain
# names are looked up in SysAInit's own directory first and then in PATH
# (`--bin-dir` replaces both); use an absolute path for anything else:
#
#     Service=/opt/systema/libexec/systema-syss
#
# Every key accepts a LIST of executables:
#
#     Key=value             replaces the list (this is the default form)
#     Key+=value            appends to the list built so far
#     Key=a:/dir.d:b        ':' separates values on one line (PATH style)
#
# Appends follow systemd's file semantics: they extend earlier assignments
# (from this file and earlier drop-ins), starting from an empty list when
# there is none.  To keep the built-in default and add an extra process,
# name both explicitly:
#
#     Service=systema-syss
#     Service+=/opt/systema-syss-helper
#
# An absolute path may also name a directory: every executable regular file
# directly inside it (non-recursive) is run, sorted by file name, in that
# order.  All executables of one key share the module's worker ID; SysAInit
# waits for that worker's readiness once, after the key's last process was
# spawned, and the separate `--log-file` names keep their logs apart:
#
#     Finder=/usr/libexec/finder.d
#     Device=/opt/systema/device-workers.d:/opt/systema/extra-device-worker
#
# Drop-ins: every /etc/systema/init.conf.d/*.conf file is read after this
# file, in lexicographic order; a later `Key=` overrides an earlier one and
# a later `Key+=` appends to it.  Copy this file to /etc/systema/init.conf
# to start overriding.
#
# Precedence, lowest to highest:
#   built-in defaults
#   < /etc/systema/init.conf
#   < /etc/systema/init.conf.d/*.conf
#   < SYSTEMA_SYSA / SYSTEMA_SYSS / ... / SYSTEMA_SYSF environment variables
#   < command line (systema-sysi --worker Key=Value, systema-sysa --finder)
#
# The SYSTEMA_SYS* variables accept the same PATH-style list, e.g.
# SYSTEMA_SYSS="systema-syss:/opt/systema-syss-helper".  They replace the
# configured list (an empty variable disables the module).

[Init]

# System A — the allocator/scheduler.  Disabling it leaves the workers
# without a control plane.
#Allocator=systema-sysa

# Finder — the executable System F runs on daemon-reload to discover units.
# The default is systema-sysf.systemd.  A directory runs every executable
# inside it, in file-name order; several values are run in configuration
# order.  An empty value disables the unit scan entirely.
#Finder=systema-sysf.systemd

# Splash — the boot-log console, started once System A is ready and before
# any worker.  It is best effort: its exit does not abort the boot.  An
# empty value disables it.
#Splash=systema-sysh.console

[Workers]

# System S — service processes (fork/exec, lifecycle, readiness).
#Service=systema-syss

# System E — .scope units wrapping externally created processes.
#External=systema-syse

# System T — .target activation.
#Target=systema-syst

# System C — .timer units (monotonic and calendar schedules).
#Cron=systema-sysc

# System K — .socket units and socket activation.
#Socket=systema-sysk

# System N — .path units.
#Path=systema-sysn

# System D — .device units.
#Device=systema-sysd

# System R — cgroup v2 resource control.
#Resource=systema-sysr.linux

# System M — .mount / .automount units.
# The built-in default is platform-specific: systema-sysm.linux on Linux,
# systema-sysm.unix elsewhere.
#Mount=systema-sysm.linux

# System W — the org.freedesktop.systemd1 D-Bus surface.
# Part of the default set only on Linux; set it explicitly to run it on
# another platform.
#Wrapper=systema-sysw.systemd
